<!-- src/modules/mailer/templates/welcome.hbs -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #4F46E5; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; background: #f9f9f9; }
        .button { display: inline-block; padding: 12px 24px; background: #4F46E5; color: white; text-decoration: none; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Welcome to Alaba Marketplace!</h1>
        </div>
        <div class="content">
            <p>Hi {{firstName}},</p>
            <p>Thank you for joining Alaba Marketplace. Your account has been successfully created.</p>
            <p><strong>Role:</strong> {{role}}</p>
            <p>Get started by exploring our platform:</p>
            <p style="text-align: center;">
                <a href="{{loginUrl}}" class="button">Go to Dashboard</a>
            </p>
        </div>
    </div>
</body>
</html>