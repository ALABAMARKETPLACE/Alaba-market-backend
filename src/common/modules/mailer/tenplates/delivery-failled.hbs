<!-- src/modules/mailer/templates/delivery-failed.hbs -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #EF4444; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; background: #FEE2E2; }
        .alert { background: #FEE2E2; border-left: 4px solid #EF4444; padding: 15px; margin: 20px 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🚨 DELIVERY ALERT</h1>
        </div>
        <div class="content">
            <div class="alert">
                <h2>Delivery Attempt Blocked!</h2>
                <p><strong>Reason:</strong> Wrong delivery code entered</p>
                <p><strong>Order Number:</strong> {{orderNumber}}</p>
                <p><strong>Time:</strong> {{timestamp}}</p>
                <p><strong>Location:</strong> {{location}}</p>
            </div>
            <p>Our system has automatically blocked this delivery attempt for security reasons.</p>
            <p><strong>What happens next?</strong></p>
            <ul>
                <li>Admin team has been notified</li>
                <li>Driver will be contacted</li>
                <li>You will receive updates shortly</li>
            </ul>
            <p>Your correct delivery code: <strong style="color: #EF4444;">{{correctCode}}</strong></p>
            <p>Wrong code entered: <strong>{{wrongCode}}</strong></p>
        </div>
    </div>
</body>
</html>