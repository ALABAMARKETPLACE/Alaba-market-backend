<!-- src/modules/mailer/templates/subscription-expired.hbs -->
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #F59E0B; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; background: #FEF3C7; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ Subscription Expired</h1>
        </div>
        <div class="content">
            <p>Hi {{companyName}},</p>
            <p>Your Alaba Marketplace subscription has expired.</p>
            <p>To continue receiving delivery orders, please renew your subscription:</p>
            <p><strong>Monthly Subscription:</strong> ₦100/month</p>
            <p style="text-align: center; margin: 20px 0;">
                <a href="{{renewUrl}}" style="display: inline-block; padding: 12px 24px; background: #F59E0B; color: white; text-decoration: none; border-radius: 5px;">
                    Renew Subscription
                </a>
            </p>
        </div>
    </div>
</body>
</html>
