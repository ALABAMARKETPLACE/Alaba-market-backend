<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 5px;
        }
        .header {
            text-align: center;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white;
            padding: 30px 20px;
            border-radius: 5px 5px 0 0;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
        }
        .content {
            background-color: white;
            padding: 30px;
            border-radius: 0 0 5px 5px;
        }
        .info-box {
            background-color: #f0f8ff;
            border-left: 4px solid #4CAF50;
            padding: 15px;
            margin: 20px 0;
            border-radius: 3px;
        }
        .order-details {
            background-color: #f5f5f5;
            padding: 15px;
            border-radius: 3px;
            margin: 20px 0;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e0e0e0;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .label {
            font-weight: bold;
            color: #666;
        }
        .value {
            color: #333;
        }
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 5px;
            margin: 20px 0;
            text-align: center;
        }
        .footer {
            text-align: center;
            font-size: 12px;
            color: #999;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }
        .status-badge {
            display: inline-block;
            background-color: #4CAF50;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
            margin: 10px 0;
        }
        .success-icon {
            font-size: 48px;
            text-align: center;
        }
        .highlight {
            background-color: #fff3cd;
            padding: 10px;
            border-radius: 3px;
            margin: 10px 0;
            border-left: 4px solid #ffc107;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="success-icon">✅</div>
            <h1>Order Delivered Successfully!</h1>
            <p>Your delivery has been completed</p>
        </div>

        <div class="content">
            <p>{{#if buyerName}}Hello {{buyerName}},{{else if sellerName}}Hello {{sellerName}},{{else}}Hello,{{/if}}</p>

            <div class="info-box">
                <p><strong>Excellent news!</strong> Your order has been successfully delivered by <strong>{{companyName}}</strong>. The recipient has confirmed receipt of the package.</p>
            </div>

            <div class="order-details">
                <div class="detail-row">
                    <span class="label">Order Number:</span>
                    <span class="value">{{orderNumber}}</span>
                </div>
                <div class="detail-row">
                    <span class="label">Delivery Company:</span>
                    <span class="value">{{companyName}}</span>
                </div>
                <div class="detail-row">
                    <span class="label">Status:</span>
                    <span class="value"><span class="status-badge">DELIVERED</span></span>
                </div>
                <div class="detail-row">
                    <span class="label">Delivery Time:</span>
                    <span class="value">{{deliveryDate}}</span>
                </div>
            </div>

            {{#if isBuyer}}
            <div class="highlight">
                <p><strong>📸 Proof of Delivery:</strong> A photo of the delivered package has been attached for your records.</p>
            </div>

            <p><strong>What's Next?</strong></p>
            <ul>
                <li>Please inspect the package upon receipt</li>
                <li>Verify that the product matches your order</li>
                <li>If there are any issues, please contact the seller immediately</li>
                <li>You can rate your delivery experience by visiting your order page</li>
            </ul>
            {{else if isSeller}}
            <p><strong>Delivery Confirmation:</strong> Your product has been successfully delivered to the buyer. The buyer has confirmed receipt of the package. Payment will be processed according to your agreement.</p>
            {{/if}}

            {{#if isCompany}}
            <div class="highlight">
                <p><strong>Order Completed:</strong> Both buyer and seller have been notified of the successful delivery. This transaction has been successfully completed in the system.</p>
            </div>
            {{/if}}

            <p style="text-align: center;">
                <a href="{{trackingLink}}" class="cta-button">View Order Details</a>
            </p>

            <p>If you have any questions or concerns about this delivery, please don't hesitate to contact us at <strong>support@alabamarketplace.com</strong>.</p>

            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0;">
                <p style="font-style: italic; color: #666;">Thank you for using Alaba Marketplace!</p>
            </div>
        </div>

        <div class="footer">
            <p>&copy; 2024 Alaba Marketplace. All rights reserved.</p>
            <p>This is an automated message. Please do not reply to this email.</p>
        </div>
    </div>
</body>
</html>
