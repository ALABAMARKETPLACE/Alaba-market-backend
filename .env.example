# ===== ENVIRONMENT =====
NODE_ENV=development
APP_NAME=alaba-market-backend
LOG_LEVEL=debug
LOG_FILE_PATH=logs/backend.log
LOG_SLOW_REQUEST_MS=1000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ===== DATABASE =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_DATABASE=alaba_marketplace_dev
DATABASE_SSL=false

# ===== EMAIL (BREVO) =====
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-email@domain.com
BREVO_SMTP_PASSWORD=your-brevo-api-key

# ===== AUTHENTICATION =====
JWT_SECRET=your-jwt-secret-here
JWT_PRIVATE_KEY=your-jwt-secret-here
JWT_EXPIRES_IN=7d
SESSION_EXPIRY=7d

# ===== PAYMENT =====
PAYSTACK_SECRET_KEY=sk_test_your_test_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key
PAYSTACK_TEST_SECRET_KEY=sk_test_your_test_key
PAYSTACK_TEST_PUBLIC_KEY=pk_test_your_test_key
BUDPAY_SECRET_KEY=sk_test_your_test_key
BUDPAY_PUBLIC_KEY=pk_test_your_test_key
BUDPAY_BASE_URL=https://api.budpay.com/api/v2
# Optional until BudPay assigns a webhook signing secret/header for your account.
BUDPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=paystack
SPLIT_PROVIDER=paystack
BUDPAY_ALLOW_COMPANY_FALLBACK=false
FRONTEND_URL=http://localhost:3000

# ===== SERVER =====
PORT=8000

# ===== REDIS / BULL =====
REDIS_URL=
REDIS_USERNAME=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULL_PREFIX=alaba-market-backend

# ===== AWS (if applicable) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
