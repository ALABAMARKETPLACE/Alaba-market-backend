# ===== ENVIRONMENT =====
NODE_ENV=development

# ===== DATABASE =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_DATABASE=alaba_marketplace_dev
DATABASE_SSL=false

# ===== EMAIL (BREVO) =====
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-email@domain.com
BREVO_SMTP_PASSWORD=your-brevo-api-key

# ===== AUTHENTICATION =====
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# ===== PAYMENT =====
PAYSTACK_SECRET_KEY=sk_test_your_test_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key

# ===== SERVER =====
PORT=8000

# ===== REDIS / BULL =====
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULL_PREFIX=alaba-market-backend

# ===== AWS (if applicable) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
