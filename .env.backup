# ===== LOCAL DEVELOPMENT ENVIRONMENT =====
NODE_ENV=development

# ===== DATABASE (LOCAL POSTGRESQL) =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ew
DATABASE_PASSWORD=password
DATABASE_DATABASE=alaba_marketplace_dev
DATABASE_SSL=false

# ===== EMAIL (BREVO) =====
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-email@domain.com
BREVO_SMTP_PASSWORD=your-brevo-api-key

# ===== AUTHENTICATION =====
JWT_SECRET=dev-jwt-secret-12345
JWT_EXPIRES_IN=7d

# ===== PAYMENT (TEST KEYS) =====
PAYSTACK_SECRET_KEY=sk_test_your_test_key
PAYSTACK_PUBLIC_KEY=pk_test_your_test_key

# ===== SERVER =====
PORT=8000

# ===== AWS (if used) =====
AWS_ACCESS_KEY_ID=your-dev-key
AWS_SECRET_ACCESS_KEY=your-dev-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-dev-bucket
