{
  "name": "nest-sequelize-typescript",
  "version": "0.0.1",
  "description": "Nest + sequelize-typescript + JWT + Jest + Swagger",
  "engines": {
    "node": "^16.19.1"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nest.js",
    "sequelize",
    "sequelize-typescript",
    "orm",
    "nodejs",
    "node.js",
    "node",
    "typescript",
    "jwt",
    "jsonwebtoken",
    "passport",
    "swagger",
    "jest"
  ],
  "author": "Irshad",
  "license": "MIT",
  "scripts": {
    "build": "node --max_old_space_size=2048 ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "ts-node node_modules/.bin/sequelize db:migrate",
    "db:drop": "ts-node node_modules/.bin/sequelize db:drop",
    "db:create": "ts-node node_modules/.bin/sequelize db:create",
    "db:seed-dev": "ts-node node_modules/.bin/sequelize db:seed:all",
    "db:seed-prod": "ts-node node_modules/.bin/sequelize db:seed:all --seeders-path db/seeders-prod",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed-dev && npm run db:seed-prod",
    "start": "node dist/main.js",
    "start:local": "nodemon",
    "start:debug": "nodemon --config nodemon-debug.json",
    "prestart:prod": "rimraf dist && npm run build",
    "start:prod": "node dist/main.js",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest --config ./test/jest-e2e.json",
    "startdev": "nodemon --delay 2000ms --watch src --ext ts --ignore '**/*.spec.ts' --exec ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.10.3",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.3.3",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/platform-socket.io": "^10.4.16",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/websockets": "^10.4.16",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.10",
    "@types/pdfjs-dist": "^2.10.378",
    "@types/sharp": "^0.32.0",
    "aws-sdk": "^2.1490.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.0.1",
    "cache-manager": "^5.4.0",
    "canvas": "^3.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "fcm-node": "^1.6.1",
    "file-type": "^19.0.0",
    "filetype": "^0.1.0",
    "firebase-admin": "^13.0.1",
    "form-data": "^4.0.0",
    "gimp": "^0.0.1-security",
    "jsonwebtoken": "^8.5.1",
    "mailtrap": "^3.4.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "paystack": "^2.0.1",
    "pdf-img-convert": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "pdf-to-img": "^4.4.0",
    "pdf-to-png-converter": "^3.6.5",
    "pdf2pic": "^3.1.4",
    "pg": "^8.7.3",
    "puppeteer": "^21.5.1",
    "read-excel-file": "^5.8.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.5.5",
    "sequelize": "^6.35.0",
    "sequelize-typescript": "^2.1.3",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^4.4.0",
    "unique-username-generator": "^1.3.0",
    "verify-apple-id-token": "^3.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.11",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node": "^20.6.3",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "@types/paystack": "^2.0.4",
    "@types/sequelize": "^4.28.13",
    "@types/supertest": "^2.0.12",
    "jest": "^28.1.0",
    "nodemon": "^2.0.16",
    "prettier": "^2.6.2",
    "sequelize-cli": "^6.6.3",
    "supertest": "^6.2.3",
    "ts-jest": "^28.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.0.0",
    "tslint": "^6.1.3",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
